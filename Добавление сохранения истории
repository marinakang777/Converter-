Функции для работы с JSON:
def save_history():
    try:
        with open(HISTORY_FILE, "w") as f:
            json.dump(history_data, f, indent=4)
    except IOError as e:
        messagebox.showerror("File Error", f"Could not save history to {HISTORY_FILE}: {e}")

def load_history():
    nonlocal history_data
    try:
        with open(HISTORY_FILE, "r") as f:
            history_data = json.load(f)
        update_history_table()
    except FileNotFoundError:
        history_data = [] # File doesn't exist yet, start fresh
    except (IOError, json.JSONDecodeError) as e:
        messagebox.showerror("File Error", f"Could not load history from {HISTORY_FILE}: {e}")
        history_data = [] # Corrupted file, reset history

